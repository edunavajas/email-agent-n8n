# Copia este fichero a .env y rellena los valores. .env no se sube al repo.
# Los flujos de n8n NO leen este fichero: la plantilla de Coolify trae
# N8N_BLOCK_ENV_ACCESS_IN_NODE=true, así que $env no funciona dentro de un nodo.
# Lo que se cambia en cámara está en el nodo Configuración de cada flujo.
# Este fichero lo usa el script de correos de prueba y te sirve de lista.

# --- Buzón (IMAP). En Hostinger: hPanel → Correos → Configurar ---
# Host IMAP: imap.hostinger.com  Puerto: 993  SSL: sí
IMAP_HOST=imap.tudominio.com
IMAP_PORT=993
IMAP_USER=soporte@tudominio.com
IMAP_PASSWORD=cambia-esto
IMAP_SECURE=true

# --- Envío (SMTP). Hostinger: smtp.hostinger.com  Puerto: 465  SSL: sí ---
# Estas cinco van TAMBIÉN en las variables del contenedor task-runners de n8n
# (no en una credencial de n8n): las lee el Code node de Python que envía.
# SMTP_SECURITY: ssl (465), starttls (587) o none.
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=soporte@tudominio.com
SMTP_PASSWORD=cambia-esto
# Solo para test-emails/send.py.
SMTP_FROM=soporte@tudominio.com

# --- Telegram. BotFather: /newbot te da el token. El chat id sale al escribirle ---
# al bot y abrir https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456:cambia-esto
TELEGRAM_CHAT_ID=cambia-esto
# Vacío si el chat es privado. En un grupo: ids de quien puede decidir, con comas.
TELEGRAM_USER_IDS=

# --- Modelo. Recomendado: deepseek-v4-flash (el Lite de la serie V4) ---
# Base compatible con la API de OpenAI. DeepSeek: https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-cambia-esto

# --- RAG del episodio 2 ---
# Si el RAG vive en el mismo n8n, n8n se llama a sí mismo por localhost.
RAG_URL=http://localhost:5678/webhook/rag-search
RAG_API_KEY=la-misma-clave-que-X-RAG-API-Key

# --- Clave interna entre los flujos (te la inventas, como la del RAG) ---
MAIL_API_KEY=inventa-otra-clave
N8N_URL=http://localhost:5678

# --- GitHub. Token fine-grained SOLO con permiso Issues sobre el repo de pruebas ---
GITHUB_TOKEN=github_pat_cambia-esto
GITHUB_REPO=tu-usuario/email-agent-sandbox
GITHUB_API_URL=https://api.github.com

# --- Umbral y plazos. Los mismos números van en el nodo Configuración ---
# Subir el umbral manda más correos a Telegram. Bajarlo responde más solo.
CONFIDENCE_THRESHOLD=0.75
MIN_RAG_SCORE=0.45
APPROVAL_HOURS=24
RETENTION_DAYS=90
# Separadas por coma, en minúsculas. Si el correo las menciona, no se responde solo.
SENSITIVE_TOPICS=precio,precios,plazo,plazos,contrato,legal,devolución,devolucion,reembolso,dni,iban,tarjeta

# --- Postgres del episodio 2, para aplicar schema.sql ---
# Host dentro de la red de Coolify: knowledge-db. Desde tu portátil hace falta un túnel.
DATABASE_URL=postgresql://knowledge:cambia-esto@knowledge-db:5432/knowledge
